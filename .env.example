# ============================================================
#  Clés API de la colonie — copie ce fichier en `.env`
#  (le .env n'est JAMAIS commis dans git)
#  Un provider sans clé est simplement désactivé au démarrage.
# ============================================================

# --- Le cerveau du Réparateur (Fable 5.1 = claude-fable-5-1) ---
ANTHROPIC_API_KEY=

# --- Google ---
GEMINI_API_KEY=
JULES_API_KEY=

# --- Agrégateurs / providers OpenAI-compatibles ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# --- Cloudflare Workers AI (OpenAI-compatible) ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- IA locale (Ollama / LM Studio / llama.cpp) — AUCUNE clé requise ---
# Installe Ollama (https://ollama.com), puis :
#   ollama pull qwen2.5-coder:7b    (ou llama3.1:8b, mistral:7b...)
# Le provider "local" de config.json détecte tout seul le modèle installé.
# Pas de clés à mettre ici : le serveur local suffit.
